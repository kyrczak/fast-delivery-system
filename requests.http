Content-Type: application/json

{
  "login": "marekk",
  "name": "Marek",
  "surname": "Kowalski",
  "registrationDate": "2024-11-18",
  "password": "pa$$w0rd",
  "email": "marekk@student.pl",
  "parcels": []
}

###

# Get all users ADMIN CREDENTIALS
// @no-cookie-jar
GET http://localhost:9080/fast-delivery/api/clients
Authorization: Basic YWRtaW46YWRtaW5hZG1pbg==
###

# Get all users USER CREDENTIALS
// @no-cookie-jar
GET http://localhost:9080/fast-delivery/api/clients
Authorization: Basic bWFyZWtrOnBhNDR3MHJk
