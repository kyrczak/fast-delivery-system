# Get all warehouses

// @no-cookie-jar
GET http://localhost:9080/fast-delivery/api/warehouses/

###

# Get all warehouse USER CREDENTIALS
// @no-cookie-jar
GET http://localhost:9080/fast-delivery/api/warehouses/
Authorization: Basic cGF0cnlrazp1c2VydXNlcg==

###

# Add warehouse AUTHORIZED / ADMIN CREDENTIALS
// @no-cookie-jar
PUT http://localhost:9080/fast-delivery/api/warehouses/3bd328e1-cb1b-4bc1-a10d-d734791d65b9
Content-Type: application/json
Authorization: Basic YWRtaW46YWRtaW5hZG1pbg==

{
  "name": "Lotnisko w Warszawie",
  "location": "Warszawa",
  "establishedDate": "1994-02-16",
  "parcels": []
}
###

# Delete warehoouse AUTHORIZED
// @no-cookie-jar
DELETE http://localhost:9080/fast-delivery/api/warehouses/3bd328e1-cb1b-4bc1-a10d-d734791d65b9
Authorization: Basic YWRtaW46YWRtaW5hZG1pbg==

###

